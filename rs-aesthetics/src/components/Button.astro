---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'secondary', size = 'md', class: className = '' } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    padding: 0.7rem 1.4rem;
    min-height: 48px;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.15s var(--ease);
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-espresso);
    color: var(--color-on-espresso);
    border-color: var(--color-espresso);
  }

  .btn--primary:hover {
    background: var(--color-espresso-hover);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border-strong);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .btn--text {
    background: none;
    border: none;
    padding: 0.3rem 0;
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .btn--lg {
    padding: 0.95rem 2rem;
    font-size: var(--text-md);
  }
</style>
