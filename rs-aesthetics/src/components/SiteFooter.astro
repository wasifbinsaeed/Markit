---
import Logo from './Logo.astro';
import { clinic } from '../data/clinic';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="light" showDescriptor />
      <p class="site-footer__tagline">
        A doctor-led aesthetic medicine clinic in Rawalpindi. Consultation before cosmetics.
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Site">
      <h2>Explore</h2>
      <ul>
        <li><a href="/treatments">Treatments</a></li>
        <li><a href="/about">About Dr. Rabia Saif</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/faqs">FAQs</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2>Visit</h2>
      <p>{clinic.address.line1}<br />{clinic.address.line2}</p>
      <ul class="site-footer__hours">
        {clinic.hours.map((h) => (
          <li><span>{h.days}</span><span>{h.time}</span></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2>Contact</h2>
      <ul>
        {clinic.phones.map((p) => (
          <li><a href={`tel:${p.tel}`}>{p.display}</a></li>
        ))}
        <li><a href={`mailto:${clinic.email}`}>{clinic.email}</a></li>
        <li><a href={clinic.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} RS Aesthetics. All rights reserved.</p>
    <ul>
      <li><a href="/privacy-policy">Privacy Policy</a></li>
      <li><a href="/terms">Terms of Use</a></li>
      <li><a href="/cancellation-policy">Cancellation Policy</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-espresso);
    color: var(--color-on-espresso);
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-10);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    padding-bottom: var(--space-7);
    border-bottom: 1px solid rgba(245, 241, 232, 0.15);
  }

  .site-footer__brand {
    max-width: 24rem;
  }

  .site-footer__tagline {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: rgba(245, 241, 232, 0.7);
    line-height: var(--leading-normal);
  }

  .site-footer__col h2 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-soft);
    margin-bottom: var(--space-4);
  }

  .site-footer__col p {
    font-size: var(--text-sm);
    color: rgba(245, 241, 232, 0.75);
    line-height: var(--leading-snug);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__col a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: rgba(245, 241, 232, 0.85);
    transition: color 0.2s var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--color-accent-soft);
  }

  .site-footer__hours {
    margin-top: var(--space-3);
  }

  .site-footer__hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(245, 241, 232, 0.75);
  }

  .site-footer__bottom {
    padding-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: rgba(245, 241, 232, 0.55);
  }

  .site-footer__bottom ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
  }

  .site-footer__bottom a {
    color: rgba(245, 241, 232, 0.55);
    text-decoration: none;
  }

  .site-footer__bottom a:hover {
    color: var(--color-accent-soft);
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  @media (min-width: 720px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
