---
import { whatsappLink, defaultWhatsAppMessage } from '../data/clinic';

interface Props {
  message?: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
  size?: 'md' | 'lg';
}

const {
  message = defaultWhatsAppMessage,
  variant = 'primary',
  class: className = '',
  size = 'md',
} = Astro.props;

const href = whatsappLink(message);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['wa-btn', `wa-btn--${variant}`, `wa-btn--${size}`, className]}
>
  <svg viewBox="0 0 32 32" aria-hidden="true" class="wa-btn__icon">
    <path fill="currentColor" d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.4.63 4.65 1.73 6.6L4 29l7.56-1.98a11.9 11.9 0 0 0 4.46.87h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3Zm0 21.9h-.01a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-4.49 1.18 1.2-4.38-.24-.45a9.86 9.86 0 0 1-1.5-5.23c0-5.46 4.45-9.9 9.94-9.9 2.65 0 5.14 1.04 7.02 2.9a9.83 9.83 0 0 1 2.9 7.01c0 5.46-4.45 9.9-9.9 9.9Zm5.44-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.46-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.5-.17 0-.37-.02-.57-.02-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.06 4.48.71.3 1.26.49 1.69.62.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"/>
  </svg>
  <span><slot>Chat on WhatsApp</slot></span>
</a>

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.15s var(--ease);
    white-space: nowrap;
  }

  .wa-btn:hover {
    transform: translateY(-1px);
  }

  .wa-btn__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .wa-btn--primary {
    background: var(--color-espresso);
    color: var(--color-on-espresso);
    border-color: var(--color-espresso);
  }

  .wa-btn--primary:hover {
    background: #322c25;
  }

  .wa-btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border-strong);
  }

  .wa-btn--secondary:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .wa-btn--text {
    background: none;
    border: none;
    padding: 0.3rem 0;
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wa-btn--lg {
    padding: 0.95rem 2rem;
    font-size: var(--text-md);
  }
</style>
