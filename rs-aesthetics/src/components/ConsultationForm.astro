---
import { treatmentCategories } from '../data/treatments';
import { whatsappLink } from '../data/clinic';
---

<div class="consult-form" data-consult-form>
  <form id="consultation-form" novalidate>
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="field">
      <label for="cf-phone">Phone / WhatsApp number</label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>

    <div class="field">
      <label for="cf-concern">Treatment or concern</label>
      <select id="cf-concern" name="concern">
        <option value="">Not sure — I'd like to discuss</option>
        {treatmentCategories.map((cat) => <option value={cat.title}>{cat.title}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="cf-preferred">Preferred day &amp; time</label>
      <input id="cf-preferred" name="preferred" type="text" placeholder="e.g. Thursday afternoon" />
    </div>

    <div class="field">
      <label for="cf-message">Message <span class="field__optional">(optional)</span></label>
      <textarea id="cf-message" name="message" rows="3"></textarea>
    </div>

    <!-- Honeypot — hidden from real visitors, catches simple bots -->
    <div class="field field--honeypot" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="consult-form__note">
      Submitting this form is a request for an appointment, not a confirmed booking. We'll get
      back to you to confirm a time.
    </p>

    <button type="submit" class="consult-form__submit">
      <span data-submit-label>Send Enquiry</span>
    </button>

    <p class="consult-form__error" data-form-error role="alert" hidden></p>
  </form>

  <div class="consult-form__success" data-form-success hidden>
    <h3>Thank you — we've received your request.</h3>
    <p>We'll get back to you shortly to confirm a time. For the fastest response, you can also send us the same details directly on WhatsApp:</p>
    <a class="consult-form__whatsapp-cta" data-whatsapp-continue href={whatsappLink()} target="_blank" rel="noopener noreferrer">
      Continue on WhatsApp
    </a>
  </div>
</div>

<script define:vars={{ waBase: whatsappLink() }} is:inline>
  const root = document.querySelector('[data-consult-form]');
  if (root) {
    const form = root.querySelector('#consultation-form');
    const errorEl = root.querySelector('[data-form-error]');
    const successEl = root.querySelector('[data-form-success]');
    const submitBtn = form.querySelector('.consult-form__submit');
    const submitLabel = form.querySelector('[data-submit-label]');
    const waContinue = root.querySelector('[data-whatsapp-continue]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';

      const data = new FormData(form);
      const name = (data.get('name') || '').toString().trim();
      const phone = (data.get('phone') || '').toString().trim();
      const concern = (data.get('concern') || '').toString().trim();
      const preferred = (data.get('preferred') || '').toString().trim();
      const message = (data.get('message') || '').toString().trim();

      if (!name || !phone) {
        errorEl.textContent = 'Please fill in your name and phone number.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitLabel.textContent = 'Send Enquiry';
        return;
      }

      let waLines = [`Hi RS Aesthetics, I'd like to book a consultation.`, `Name: ${name}`, `Phone: ${phone}`];
      if (concern) waLines.push(`Concern: ${concern}`);
      if (preferred) waLines.push(`Preferred: ${preferred}`);
      if (message) waLines.push(`Message: ${message}`);
      const waUrl = `${waBase}?text=${encodeURIComponent(waLines.join('\n'))}`;
      waContinue.setAttribute('href', waUrl);

      try {
        const res = await fetch('/api/consultation-request.php', { method: 'POST', body: data });
        const result = await res.json().catch(() => ({ ok: false }));

        if (res.ok && result.ok) {
          form.hidden = true;
          successEl.hidden = false;
          successEl.setAttribute('tabindex', '-1');
          successEl.focus();
        } else {
          errorEl.textContent =
            result.error || 'Something went wrong sending your request. Please message us on WhatsApp instead.';
          errorEl.hidden = false;
        }
      } catch {
        errorEl.textContent =
          "We couldn't reach the server — this can happen when testing locally, since the form only works once the site is live. Please message us on WhatsApp instead.";
        errorEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Send Enquiry';
      }
    });
  }
</script>

<style>
  .consult-form {
    max-width: 32rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field--honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field__optional {
    color: var(--color-ink-faint);
    font-weight: 400;
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    min-height: 48px;
  }

  textarea {
    min-height: 6rem;
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 2px;
  }

  .consult-form__note {
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    line-height: var(--leading-normal);
  }

  .consult-form__submit,
  .consult-form__whatsapp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-md);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-espresso);
    background: var(--color-espresso);
    color: var(--color-on-espresso);
    padding: 0.95rem 2rem;
    min-height: 48px;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), transform 0.15s var(--ease);
  }

  .consult-form__submit:hover,
  .consult-form__whatsapp-cta:hover {
    background: var(--color-espresso-hover);
    transform: translateY(-1px);
  }

  .consult-form__submit:focus-visible,
  .consult-form__whatsapp-cta:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 3px;
  }

  .consult-form__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .consult-form__error {
    color: var(--color-error);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .consult-form__success {
    max-width: 30rem;
  }

  .consult-form__success h3 {
    font-size: var(--text-xl);
  }

  .consult-form__success p {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
  }

  .consult-form__success :global(.btn) {
    margin-top: var(--space-5);
  }
</style>
